    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.10.0",
