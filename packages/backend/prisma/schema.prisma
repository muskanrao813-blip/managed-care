generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Cohort {
  MODERATE
  HIGH
  VERY_HIGH
}

enum EngagementCapacity {
  LOW
  MEDIUM
  HIGH
}

enum Level {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum FrustrationStage {
  NORMAL
  CAUTION
  BACKOFF
  SOFT_REST
}

enum ActivityStatus {
  PENDING
  COMPLETED
  MISSED
  ATTEMPTED
  LOCKED
}

enum ActivityDomain {
  DIET
  STEPS
  MENTAL
  COC
  HRA
  WEIGHT
  CLINICAL
  EVERGREEN
}

enum NudgeChannel {
  WHATSAPP
  APP_NUDGE
  VOICE_BOT
  AGENT_TASK
}

enum NudgeStatus {
  PENDING
  SENT
  RESPONDED
  IGNORED
  CANCELLED
}

enum AppointmentType {
  DOCTOR
  DIETICIAN
  LAB_TEST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  RESCHEDULED
  MISSED
}

enum SfdcTaskType {
  WELCOME_CALL
  MISSED_CONSULT
  MISSED_LAB
  MISSED_MEDICATION
  WORSENING_LAB
  EMERGENCY
}

enum SfdcTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SfdcTaskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

enum WellnessSessionType {
  MEDITATION
  BOX_BREATHING
  CBT
  PROGRESSIVE_RELAXATION
  GUIDED_IMAGERY
  GROUNDING
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum StepSource {
  MANUAL
  WEARABLE
  PEDOMETER
}

enum LabSource {
  UPLOAD
  MANUAL
  CHECK_IN
}

model Patient {
  id                 String             @id @default(cuid())
  name               String
  age                Int
  gender             Gender
  department         String
  city               String
  enrollmentDate     DateTime           @default(now())
  programId          String
  cohort             Cohort
  engagementScore    Int                @default(50)
  personaStyle       String
  engagementCapacity EngagementCapacity @default(MEDIUM)
  baselineLabValues  Json
  currentLabValues   Json
  dayNumber          Int                @default(1)
  points             Int                @default(0)
  level              Level              @default(BRONZE)
  streaks            Json               @default("{\"medication\":0,\"steps\":0,\"mealLog\":0}")
  frustrationStage   FrustrationStage   @default(NORMAL)
  smartSendTime      String             @default("08:30")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  labReports       LabReport[]
  hraResponses     HraResponse[]
  activities       Activity180Day[]
  appointments     ClinicalAppointment[]
  nudgeEvents      NudgeEvent[]
  predictions      OutcomePrediction[]
  sfdcTasks        SfdcTask[]
  wellnessSessions WellnessSession[]
  stepLogs         StepLog[]
  moodLogs         MoodLog[]
  mealLogs         MealLog[]
}

model LabReport {
  id         String    @id @default(cuid())
  patientId  String
  reportDate DateTime  @default(now())
  values     Json
  source     LabSource @default(MANUAL)
  isBaseline Boolean   @default(false)
  createdAt  DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model HraResponse {
  id                    String   @id @default(cuid())
  patientId             String
  responseDate          DateTime @default(now())
  dayNumber             Int
  answers               Json
  engagementScoreResult Int
  personaResult         String
  createdAt             DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Activity180Day {
  id              String         @id @default(cuid())
  patientId       String
  dayNumber       Int
  activityType    String
  domain          ActivityDomain
  isClinical      Boolean        @default(false)
  isEvergreen     Boolean        @default(false)
  status          ActivityStatus @default(PENDING)
  scheduledDate   DateTime
  completedAt     DateTime?
  pointsEarned    Int            @default(0)
  completionData  Json?
  intent          String
  completionLogic String
  benefitGatePoints Int          @default(0)

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nudgeEvents NudgeEvent[]
}

model ClinicalAppointment {
  id                      String            @id @default(cuid())
  patientId               String
  type                    AppointmentType
  scheduledDate           DateTime
  providerName            String
  status                  AppointmentStatus @default(SCHEDULED)
  confirmationChannel     String?
  confirmedAt             DateTime?
  completedAt             DateTime?
  prescriptionSubmittedAt DateTime?
  labResultsReceivedAt    DateTime?
  dietPlanGeneratedAt     DateTime?
  notes                   String?
  pointsAwarded           Boolean           @default(false)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model NudgeEvent {
  id             String       @id @default(cuid())
  patientId      String
  activityId     String
  channel        NudgeChannel
  tier           Int
  scheduledAt    DateTime
  sentAt         DateTime?
  respondedAt    DateTime?
  response       String?
  status         NudgeStatus  @default(PENDING)
  messageContent Json

  patient  Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  activity Activity180Day @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model OutcomePrediction {
  id                       String   @id @default(cuid())
  patientId                String
  date                     DateTime
  predictedValue           Float
  baselineValue            Float
  actualValue              Float?
  adherenceContribution    Float    @default(0)
  consultationContribution Float    @default(0)
  labAdjustmentApplied     Boolean  @default(false)
  dayNumber                Int
  lineType                 String   @default("MY_PATH")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model SfdcTask {
  id           String           @id @default(cuid())
  patientId    String
  nudgeEventId String?
  sfdcTaskId   String           @unique
  type         SfdcTaskType
  priority     SfdcTaskPriority
  status       SfdcTaskStatus   @default(OPEN)
  subject      String
  description  String
  callScript   String
  outcome      String?
  agentNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model WellnessSession {
  id              String              @id @default(cuid())
  patientId       String
  activityId      String
  sessionType     WellnessSessionType
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  completed       Boolean             @default(false)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model StepLog {
  id          String     @id @default(cuid())
  patientId   String
  date        DateTime
  stepsLogged Int
  targetSteps Int
  source      StepSource @default(MANUAL)
  targetMet   Boolean
  createdAt   DateTime   @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model MoodLog {
  id        String   @id @default(cuid())
  patientId String
  date      DateTime
  score     Int
  note      String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model MealLog {
  id            String   @id @default(cuid())
  patientId     String
  mealType      MealType
  loggedAt      DateTime @default(now())
  description   String?
  calories      Int?
  photoUrl      String?
  nutritionData Json?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
